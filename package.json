{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit -p . && npm run check:pods --silent && esbuild tools/ci/sim.ts --bundle --platform=node --format=esm --outfile=tools/ci/out/sim.mjs --log-level=error && node tools/ci/out/sim.mjs",
    "check:gpu": "node tools/ci/gpu.mjs",
    "save": "sh tools/save.sh",
    "restore-git": "sh tools/restore-git.sh",
    "check:pods": "esbuild tools/ci/pods.ts --bundle --platform=node --format=esm --outfile=tools/ci/out/pods.mjs --log-level=error && node tools/ci/out/pods.mjs"
  },
  "dependencies": {
    "@types/three": "^0.187.0",
    "clsx": "2.1.1",
    "lucide-react": "^1.73.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.0"
  }
}
